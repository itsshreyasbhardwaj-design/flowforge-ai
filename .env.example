# FlowForge runs fully offline with none of these set: a deterministic mock model,
# local lexical embeddings, an in-memory vector store, and a JSON file database.
# Set them only to swap a component for a hosted one.

# --- Models ---------------------------------------------------------------
# One key, every major model. https://openrouter.ai
# Without it, workflows use `flowforge/mock` — a deterministic offline model.
# OPENROUTER_API_KEY=

# Real embeddings. Without it, the built-in lexical embedder is used.
# OPENAI_API_KEY=

# --- Security -------------------------------------------------------------
# REQUIRED IN PRODUCTION. Derives the AES-256-GCM key that encrypts stored
# credentials. Generate with: openssl rand -base64 32
# The development fallback is a public constant and protects nothing.
# FLOWFORGE_SECRET_KEY=

# --- Storage --------------------------------------------------------------
# Where the default file store writes. Defaults to ./.flowforge/store.json
# FLOWFORGE_DATA_FILE=

# --- Execution ------------------------------------------------------------
# Maximum sub-workflow nesting depth. Defaults to 5.
# FLOWFORGE_MAX_DEPTH=5

# Isolated runner for the Python node. No runner ships by default, because
# executing untrusted Python in the web process would be a remote-code-execution
# hole. See docs/plugins.md.
# PYTHON_RUNNER_URL=

# --- Optional node credentials -------------------------------------------
# Prefer adding these through Settings → Credentials so they are encrypted at
# rest. Environment variables are the fallback for containerised deploys.
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# GITHUB_TOKEN=
# BRAVE_SEARCH_API_KEY=
